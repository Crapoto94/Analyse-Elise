# Copier en .env à côté de docker-compose.yml sur le serveur (jamais versionné) et renseigner les valeurs.

# API centrale APM (envoi de mails, authentification AD)
APM_API_URL=https://api.ivry.local
APM_API_KEY=

# API métier Hub DSI (organisation, encadrants, assistantes de direction)
HUBDSI_API_URL=http://10.103.130.106:3001
HUBDSI_API_KEY=

# StudioRH (recherche d'agents pour saisir un e-mail à la main)
STUDIORH_API_URL=https://studiorh.ivry.local
STUDIORH_API_KEY=

# Connexion par identifiants AD (via APM) : identifiants séparés par des virgules
AD_ADMIN_USERS=
AD_ALLOWED_USERS=

# Certificat de l'autorité de la Ville (fichier .pem déposé dans ./certs)
VILLE_CA_FILE=/app/certs/ville-ca.pem
